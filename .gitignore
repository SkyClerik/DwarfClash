# ==============================================================================
# Global ignores
# ==============================================================================
# Generic log files
*.log

# ==============================================================================
# Unity Project Specific Ignores (Dwarf-clash-game)
# ==============================================================================
# Unity generated folders
/Dwarf-clash-game/.utmp/
/Dwarf-clash-game/[Ll]ibrary/
/Dwarf-clash-game/[Tt]emp/
/Dwarf-clash-game/[Oo]bj/
/Dwarf-clash-game/[Bb]uild/
/Dwarf-clash-game/[Bb]uilds/
/Dwarf-clash-game/[Ll]ogs/
/Dwarf-clash-game/[Uu]ser[Ss]ettings/

# Unity generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
/Dwarf-clash-game/sysinfo.txt

# Mono auto generated files
/Dwarf-clash-game/mono_crash.*

# Builds
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# Crashlytics generated file
/Dwarf-clash-game/crashlytics-build.properties

# TestRunner generated files
/Dwarf-clash-game/InitTestScene*.unity*

# Addressables default ignores, before user customizations
/Dwarf-clash-game/ServerData
/Dwarf-clash-game/[Aa]ssets/StreamingAssets/aa*
/Dwarf-clash-game/[Aa]ssets/AddressableAssetsData/link.xml*
/Dwarf-clash-game/[Aa]ssets/Addressables_Temp*
/Dwarf-clash-game/[Aa]ssets/AddressableAssetsData/*/*.bin*

# Visual Scripting auto-generated files
/Dwarf-clash-game/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
/Dwarf-clash-game/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
/Dwarf-clash-game/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
/Dwarf-clash-game/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta

# Auto-generated scenes by play mode tests
/Dwarf-clash-game/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*

# Specific Unity Project folders
/Dwarf-clash-game/Gnome Clash/Library
/Dwarf-clash-game/Gnome Clash/Temp
/Dwarf-clash-game/Gnome Clash/obj

# ==============================================================================
# Blender (Unity related)
# ==============================================================================
# By default unity supports Blender asset imports, *.blend1 blender files do not need to be commited to version control.
*.blend1
*.blend1.meta

# ==============================================================================
# Memory and Recordings (Unity related)
# ==============================================================================
# MemoryCaptures can get excessive in size.
# They also could contain extremely sensitive data
/Dwarf-clash-game/[Mm]emoryCaptures/

# Recordings can get excessive in size
/Dwarf-clash-game/[Rr]ecordings/

# ==============================================================================
# Visual Studio / IDE related ignores (Dwarf-clash-game)
# ==============================================================================
# Visual Studio cache directory
/Dwarf-clash-game/.vs/
/Dwarf-clash-game/.vsconfig
.editorconfig
/.vscode/

# Gradle cache directory
/Dwarf-clash-game/.gradle/

# Autogenerated VS/MD/Consulo solution and project files
/Dwarf-clash-game/ExportedObj/
/Dwarf-clash-game/.consulo/
/Dwarf-clash-game/*.csproj
*.unityproj
/Dwarf-clash-game/*.sln
*.suo
*.tmp
*.user
*.userprefs
/Dwarf-clash-game/*.pidb
/Dwarf-clash-game/*.booproj
/Dwarf-clash-game/*.svd
*.mdb
*.opendb
*.VC.db
*_i.c
*_p.c
*_i.h
*.ilk
*.pch
*.pdb
*.pgc
*.pgd
*.rsp
*.sbr
*.tlb
*.tli
*.tlh
*.tmp_proj
*.vspscc
*.vssscc
.builds
*.svclog
*.scc

# Autogenerated Jetbrains Rider plugin
/Dwarf-clash-game/[Aa]ssets/Plugins/Editor/JetBrains*
# Jetbrains Rider personal-layer settings
*.DotSettings.user


# ==============================================================================
# FMOD Unity Integration
# ==============================================================================
# Never ignore DLLs in the FMOD subfolder, so make sure that the FMOD-folder is in the correct path.
!/[Aa]ssets/Plugins/FMOD/**/*.dll

# Don't ignore images and gizmos used by FMOD in the Unity Editor
!/[Aa]ssets/Gizmos/FMOD/*
!/[Aa]ssets/Editor Default Resources/FMOD/*

# Ignore the Cache-file since it is updated locally either way
/[Aa]ssets/**/FMODStudioCache.asset
/[Aa]ssets/**/FMODStudioCache.asset.meta
/[Aa]ssets/Plugins/FMOD/Cache.meta
/[Aa]ssets/Plugins/FMOD/Cache/Editor.meta

# Log-files
fmod.log
fmod_editor.log

# FMOD 1.10.x (Legacy)
/Assets/FMODAssets/*
/Assets/FMODStudioCache.meta

# ==============================================================================
# Backend Project Specific Ignores (Dwarf-clash-backend)
# ==============================================================================
# Build artifacts and temporary files
/Dwarf-clash-backend/[Dd]ebug/
/Dwarf-clash-backend/[Dd]ebugPublic/
/Dwarf-clash-backend/[Rr]elease/
/Dwarf-clash-backend/[Rr]eleases/
/Dwarf-clash-backend/x64/
/Dwarf-clash-backend/x86/
/Dwarf-clash-backend/build/
/Dwarf-clash-backend/bld/
/Dwarf-clash-backend/[Bb]in/
/Dwarf-clash-backend/[Oo]bj/

# MSTest test Results
/Dwarf-clash-backend/[Tt]est[Rr]esult*/
/Dwarf-clash-backend/[Bb]uild[Ll]og.*

# NUNIT
/Dwarf-clash-backend/*.VisualState.xml
/Dwarf-clash-backend/TestResult.xml

# Visual Studio profiler
*.psess
*.vsp
*.vspx
*.sap

# NuGet Packages
/Dwarf-clash-backend/*.nupkg
/Dwarf-clash-backend/**/packages/*
!/Dwarf-clash-backend/**/packages/build/

# Windows Store app package directory
/Dwarf-clash-backend/AppPackages/
/Dwarf-clash-backend/BundleArtifacts/

# Visual Studio cache files
/Dwarf-clash-backend/*.[Cc]ache
!/Dwarf-clash-backend/*.[Cc]ache/

# Others
/Dwarf-clash-backend/ClientBin/
/Dwarf-clash-backend/~$*
/Dwarf-clash-backend/*~
/Dwarf-clash-backend/*.dbmdl
/Dwarf-clash-backend/*.dbproj.schemaview
/Dwarf-clash-backend/*.pfx
/Dwarf-clash-backend/*.publishsettings
/Dwarf-clash-backend/node_modules/
/Dwarf-clash-backend/orleans.codegen.cs

# ==============================================================================
# Backup & Report Files
# ==============================================================================
# Backup & report files from converting an old project file
# to a newer Visual Studio version. Backup files are not needed,
# because we have git ;-)
_UpgradeReport_Files/
Backup*/
UpgradeLog*.XML
UpgradeLog*.htm

# ==============================================================================
# Optional Ignores (Uncomment to enable)
# ==============================================================================
# /[Aa]ssets/AssetStoreTools*
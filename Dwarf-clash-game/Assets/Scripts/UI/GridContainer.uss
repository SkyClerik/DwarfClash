/* Styling for the GridContainer itself */
.grid-container {
    flex-grow: 1;
    background-color: rgba(0, 0, 0, 0.2); /* Semi-transparent background for the container */
    padding: 10px;
    border-width: 2px;
    border-color: #555;
}

/* Styling for the individual cells generated by GridContainer */
.grid-container > .unity-visual-element {
    background-color: rgba(255, 255, 255, 0.1); /* Lighter background for cells */
    border-width: 1px;
    border-color: #333;
    border-radius: 5px;
    justify-content: center;
    align-items: center;
    color: white; /* For any text inside cells, if added later */
}
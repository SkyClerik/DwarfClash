<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="root" picking-mode="Ignore" style="flex-grow: 1; justify-content: center; align-items: center; background-image: url(&quot;project://database/Assets/UI%20Toolkit/imageUpdating/%D1%84%D0%BE%D0%BD%20%D0%B8%D0%B3%D1%80%D1%8B.png?fileID=2800000&amp;guid=860052f13cc266e4289c1751205db00b&amp;type=3#фон игры&quot;); -unity-background-scale-mode: scale-and-crop;">

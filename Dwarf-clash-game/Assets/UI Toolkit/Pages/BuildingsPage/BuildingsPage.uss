.custom-progress-bar {
    height: 20px;
    background-color: rgb(51, 51, 51);
    border-radius: 10px;
    position: relative;
    overflow: hidden;
    width: 90%;
    margin-top: 10px;
    margin-right: 0;
    margin-bottom: 0;
}

.custom-progress-bar__background {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    width: 58%;
    background-color: blue;
    border-radius: 10px;
}

.custom-progress-bar__foreground {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    width: 40%;
    background-color: yellow;
    border-radius: 10px;
}

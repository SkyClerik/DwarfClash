<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/Resources/ElementsStyles/WindowSettingStyle.uss?fileID=7433441132597879392&amp;guid=90f323877b3b57145a5328eece4be0be&amp;type=3#WindowSettingStyle" />
    <Style src="project://database/Assets/UI%20Toolkit/Resources/ElementsStyles/RadioButtonGroupHorizontalStyle.uss?fileID=7433441132597879392&amp;guid=8bc056288dbdf7540a465c3a009f7b34&amp;type=3#RadioButtonGroupHorizontalStyle" />
    <Style src="project://database/Assets/UI%20Toolkit/Resources/ElementsStyles/ToggleSlider.uss?fileID=7433441132597879392&amp;guid=fbd8fb286b4236d469c458f8643e0be1&amp;type=3#ToggleSlider" />
    <Style src="project://database/Assets/UI%20Toolkit/Resources/ElementsStyles/SliderSoundStyle.uss?fileID=7433441132597879392&amp;guid=cbd11f359ec2eb24e98b5cbc4250ca5c&amp;type=3#SliderSoundStyle" />
    <Style src="project://database/Assets/UI%20Toolkit/Resources/ElementsStyles/OnOffToggleStyle.uss?fileID=7433441132597879392&amp;guid=cbd476d29aebe4f468c64b5ea712f2ea&amp;type=3#OnOffToggleStyle" />
    <ui:VisualElement name="setting_window_container" picking-mode="Ignore" style="flex-grow: 1; align-items: center; justify-content: center; display: flex; visibility: visible; width: 100%; height: 100%;">
        <ui:VisualElement name="modal_cover" style="flex-grow: 1; position: absolute; left: 0; top: 0; right: 0; bottom: 0;" />
        <ui:VisualElement name="setting_window" style="flex-grow: 0; width: 70%; height: 70%; align-items: center; align-self: center; flex-shrink: 0; justify-content: space-between; flex-direction: column; background-image: url(&quot;project://database/Assets/UI%20Toolkit/imageUpdating/Inventory/2.png?fileID=21300000&amp;guid=e3a88ace412aebe4382bde4271af1287&amp;type=3#2&quot;); visibility: visible;">
            <ui:VisualElement name="row_1" style="flex-direction: column; align-self: center; width: 70%; height: 30%; justify-content: space-between; top: 10%;">
                <ui:VisualElement name="music_box" style="flex-grow: 1; flex-direction: row-reverse; justify-content: space-between;">
                    <ui:Toggle label="On" name="music_toggle" value="true" class="on-off-toggle" style="color: rgb(255, 255, 255); -unity-font-definition: initial; -unity-font: resource(&apos;Fonts &amp; Materials/KZ Supercell-Magic&apos;); font-size: 50px; flex-direction: column; align-items: center; justify-content: center; width: 15%;" />
                    <ui:Slider high-value="1" name="music_slider" class="audio-slider" style="width: 50%; -unity-font-definition: resource(&apos;Fonts &amp; Materials/KZ Supercell-Magic SDF&apos;); -unity-font: resource(&apos;Fonts &amp; Materials/KZ Supercell-Magic&apos;); color: rgb(255, 255, 255); font-size: 50px; justify-content: space-between; align-items: flex-start; min-height: auto;" />
                    <ui:Label tabindex="-1" text="Music" parse-escape-sequences="true" display-tooltip-when-elided="true" name="music_label" style="font-size: 50px; -unity-font: resource(&apos;Fonts &amp; Materials/KZ Supercell-Magic&apos;); -unity-font-definition: resource(&apos;Fonts &amp; Materials/KZ Supercell-Magic SDF&apos;); color: rgb(255, 255, 255); width: 25%; align-self: center;" />
                </ui:VisualElement>
                <ui:VisualElement name="sound_box" style="flex-grow: 1; flex-direction: row-reverse; justify-content: space-between; align-items: stretch;">
                    <ui:Toggle label="On" name="sound_toggle" value="true" class="on-off-toggle" style="font-size: 50px; -unity-font-definition: initial; -unity-font: resource(&apos;Fonts &amp; Materials/KZ Supercell-Magic&apos;); color: rgb(255, 255, 255); flex-direction: column; align-items: center; justify-content: center; width: 15%;" />
                    <ui:Slider high-value="1" name="sound_slider" class="audio-slider" style="width: 50%; -unity-font-definition: resource(&apos;Fonts &amp; Materials/KZ Supercell-Magic SDF&apos;); -unity-font: resource(&apos;Fonts &amp; Materials/KZ Supercell-Magic&apos;); color: rgb(255, 255, 255); font-size: 50px; justify-content: space-between; align-items: flex-start; min-height: auto;" />
                    <ui:Label tabindex="-1" text="Sound" parse-escape-sequences="true" display-tooltip-when-elided="true" name="sound_label" style="font-size: 50px; -unity-font: resource(&apos;Fonts &amp; Materials/KZ Supercell-Magic&apos;); -unity-font-definition: resource(&apos;Fonts &amp; Materials/KZ Supercell-Magic SDF&apos;); color: rgb(255, 255, 255); width: 25%; align-self: center;" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="row_2" style="flex-direction: row; justify-content: space-between; align-self: center; align-items: center; width: 70%; top: auto;">
                <ui:Button name="sound" text="Sound" class="button" style="-unity-font: resource(&apos;Fonts &amp; Materials/KZ Supercell-Magic&apos;); -unity-font-style: bold; -unity-font-definition: initial; width: 300px;" />
                <ui:Button name="graphics" text="Graphics" class="button" style="-unity-font-definition: initial; width: 300px;" />
            </ui:VisualElement>
            <ui:VisualElement name="row_3" style="flex-direction: row; align-self: center; justify-content: space-around; align-items: center; width: 70%; top: auto;">
                <ui:Button name="discord" text="Discord" class="button" style="-unity-font-definition: initial;" />
                <ui:Button name="x" text="X" class="button" style="-unity-font-definition: initial;" />
                <ui:Button name="vk" text="VK" class="button" style="-unity-font-definition: initial;" />
            </ui:VisualElement>
            <ui:VisualElement name="bottom_bar" style="align-items: center; flex-direction: row; justify-content: space-between; width: 70%;">
                <ui:Button name="privacy" text="Privacy Policy" enable-rich-text="false" class="buttonBigText" style="-unity-font-definition: initial;" />
                <ui:Button name="tell_us" text="Tell us about a problem" class="button buttonBigText" style="-unity-font: resource(&apos;Fonts &amp; Materials/KZ Supercell-Magic&apos;); -unity-font-definition: initial;" />
                <ui:Button name="close_setting" class="buttonCircle" style="align-items: center; align-self: center; width: 150px; justify-content: flex-end; height: 150px; flex-shrink: 0; flex-grow: 0; font-size: 70px; -unity-font: resource(&apos;Fonts &amp; Materials/KZ Supercell-Magic&apos;); background-image: url(&quot;project://database/Assets/UI%20Toolkit/imageUpdating/Inventory/7.png?fileID=21300000&amp;guid=1b81b9809a19af741970cff919e1cde5&amp;type=3#7&quot;);" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="graphics_window_container" picking-mode="Ignore" style="flex-grow: 1; position: absolute; width: 100%; height: 100%; justify-content: center; align-items: center; display: none; top: -1px; left: 0;">
        <ui:VisualElement name="modal_cover" style="flex-grow: 1; position: absolute; left: 0; top: 0; right: 0; bottom: 0;" />
        <ui:VisualElement name="graphics_window" style="flex-grow: 0; width: 70%; height: 70%; align-items: center; align-self: center; flex-shrink: 0; justify-content: space-between; flex-direction: column; background-image: url(&quot;project://database/Assets/UI%20Toolkit/imageUpdating/Inventory/2.png?fileID=21300000&amp;guid=e3a88ace412aebe4382bde4271af1287&amp;type=3#2&quot;);">
            <ui:VisualElement name="row_1" style="flex-direction: row; align-self: center; width: 70%; height: auto; justify-content: space-between; top: 20%;">
                <ui:Label tabindex="-1" text="fps" parse-escape-sequences="true" display-tooltip-when-elided="true" name="fps_label" style="-unity-font: resource(&apos;Fonts &amp; Materials/KZ Supercell-Magic&apos;); font-size: 60px; -unity-font-definition: initial; color: rgb(255, 249, 249);" />
                <ui:VisualElement name="framerate_element" focusable="false" tabindex="0" style="flex-grow: 0; flex-direction: row; align-items: center; justify-content: center; width: auto; align-self: center;">
                    <ui:Label tabindex="-1" text="30" parse-escape-sequences="true" display-tooltip-when-elided="true" name="label_30_fps" style="-unity-font: resource(&apos;Fonts &amp; Materials/KZ Supercell-Magic&apos;); -unity-font-definition: initial; font-size: 60px; color: rgb(255, 255, 255);" />
                    <ui:Toggle name="framerate" class="switch-toggle unity-checkmark unity-toggle__checkmark" style="height: 100%; width: 150px; justify-content: center; align-items: center; background-color: rgba(240, 240, 240, 0);" />
                    <ui:Label tabindex="-1" text="60" parse-escape-sequences="true" display-tooltip-when-elided="true" name="label_60_fps" style="-unity-font: resource(&apos;Fonts &amp; Materials/KZ Supercell-Magic&apos;); -unity-font-definition: initial; font-size: 60px; color: rgb(255, 255, 255);" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="row_2" style="flex-direction: row; justify-content: space-between; align-self: center; align-items: center; width: 70%; top: 10%;">
                <ui:RadioButtonGroup value="0" name="radio_button_group_graphics" choices="Low,Med,High" style="font-size: 60px; -unity-font-definition: initial; -unity-font: resource(&apos;Fonts &amp; Materials/KZ Supercell-Magic&apos;); color: rgb(255, 255, 255); width: 100%;" />
            </ui:VisualElement>
            <ui:VisualElement name="bottom_bar" style="align-items: center; flex-direction: row; justify-content: space-between; width: 70%;">
                <ui:Button name="privacy" text="Privacy Policy" enable-rich-text="false" class="buttonBigText" style="-unity-font-definition: initial;" />
                <ui:Button name="tell_us" text="Tell us about a problem" class="button buttonBigText" style="-unity-font: resource(&apos;Fonts &amp; Materials/KZ Supercell-Magic&apos;); -unity-font-definition: initial;" />
                <ui:Button name="close_graphics" class="buttonCircle" style="align-items: center; align-self: center; width: 150px; justify-content: flex-end; height: 150px; flex-shrink: 0; flex-grow: 0; font-size: 70px; -unity-font: resource(&apos;Fonts &amp; Materials/KZ Supercell-Magic&apos;); background-image: url(&quot;project://database/Assets/UI%20Toolkit/imageUpdating/Inventory/7.png?fileID=21300000&amp;guid=1b81b9809a19af741970cff919e1cde5&amp;type=3#7&quot;);" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>

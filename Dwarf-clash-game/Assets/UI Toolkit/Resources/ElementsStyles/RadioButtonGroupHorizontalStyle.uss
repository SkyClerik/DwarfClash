#unity-radio-button-group__container {
    flex-direction: row;

    justify-content:space-between; 
    width: 100%
    
}

#unity-radio-button-group__container .unity-radio-button__input{
    
    flex-direction: column-reverse;
    
}

.unity-radio-button__checkmark-background{
    width: 50px;
    height: 50px;
    border-radius: 100%;
    justify-content: center;
    align-items: center;
    padding: 0px;
}

.unity-radio-button__checkmark{
    width: 80%;
    height: 80%;
    border-radius: 50%;

    padding: 0px;
    margin: 0px;
    
}
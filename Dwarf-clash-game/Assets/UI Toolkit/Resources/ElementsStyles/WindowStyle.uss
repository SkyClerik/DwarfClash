.TextStyle {
    -unity-font-definition: resource('Fonts & Materials/KZ Supercell-Magic SDF');
}

.slot-box {
    width: 100%;
    padding-bottom: 100%;
    position: relative;
}

.slot-box > * {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
}
